# Backend base URL — Fastify sidecar on port 4000 in dev.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# When "true", chat REST + Socket.IO are handled by an in-browser fake
# (BroadcastChannel + Web Locks). Auth is ALWAYS real. Set to "false" once
# the chat backend is available.
NEXT_PUBLIC_USE_FAKE_BACKEND=true

# Dev-only: probability (0..1) that the fake socket drops a broadcast,
# forcing the client to gap-fill on the next live event. Default 0.
NEXT_PUBLIC_FAKE_DROP_PROB=0
