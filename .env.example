# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic API key — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use in the app's /api/chat route
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: if you add a second provider
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# App
NEXT_PUBLIC_APP_NAME="Hackathon App"
