# Copy to .env and fill in. Never commit .env.
# Loaded by docker compose + apps/backend at dev time (via dotenv wiring in S1).

# ---------------- Postgres ----------------
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# ---------------- Redis ----------------
REDIS_URL=redis://localhost:6379

# ---------------- Backend (Fastify) ----------------
PORT=4000
LOG_LEVEL=info
# Must be at least 32 chars — signs better-auth sessions + CSRF
SESSION_SECRET=change-me-in-prod-32-char-min-xxxxxx
# Where file uploads land on local FS (v3.docx §3.4)
UPLOAD_DIR=./infra/uploads
# CORS origin for the Next.js app
WEB_ORIGIN=http://localhost:3000
# REQ-158 — comma-separated better-auth user IDs allowed into /admin.
# Default = alice's stable UUID from scripts/seed.ts, so `docker compose up`
# gives judges an admin session out-of-box. Append more ids (comma-sep) to
# promote additional accounts; set to empty to lock everyone out.
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000001

# ---------------- Web (Next.js) ----------------
# Public URL the browser hits for REST + Socket.IO
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="AI Herders Jam"
