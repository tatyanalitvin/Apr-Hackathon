{
  "name": "ai-herders-jam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:web": "pnpm --filter @ai-herders/web dev",
    "dev:backend": "pnpm --filter @ai-herders/backend dev",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel --stream start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ai-herders/backend db:generate",
    "db:migrate": "pnpm --filter @ai-herders/backend db:migrate",
    "db:studio": "pnpm --filter @ai-herders/backend db:studio",
    "db:seed": "pnpm --filter @ai-herders/backend db:seed",
    "trace": "node scripts/trace-req-ids.mjs",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "prettier": "^3.4.2",
    "redis": "^4.7.0",
    "typescript": "^5.7.2"
  }
}
