// Prisma schema for AI Herders Jam — Online Chat Server
//
// Data model reflects the brief section-by-section. When editing, keep the comments
// in sync with the spec sections they implement (§2.1, §2.3, etc.). That way Claude
// can follow the requirement-to-schema trail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// §2.1 Users
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique // immutable per §2.1.2
  passwordHash String
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  sessions        Session[]
  ownedRooms      Room[]            @relation("RoomOwner")
  memberships     Membership[]
  messages        Message[]
  sentRequests    FriendRequest[]   @relation("FriendReqFrom")
  recvRequests    FriendRequest[]   @relation("FriendReqTo")
  friendsA        Friendship[]      @relation("FriendA")
  friendsB        Friendship[]      @relation("FriendB")
  bansIssued      UserBlock[]       @relation("BlockBy")
  bansReceived    UserBlock[]       @relation("BlockTarget")
  attachments     Attachment[]

  @@index([deletedAt])
}

// §2.2.4 Sessions — persistent login, multi-device
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

// §2.3.3 / §2.3.4 Friends (accepted state only; requests are separate)
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Normalize so (A,B) with A.id < B.id — unique pair
  @@unique([userAId, userBId])
  @@index([userBId])
}

// §2.3.2 Friend requests (pending or rejected)
model FriendRequest {
  id         String        @id @default(cuid())
  fromId     String
  toId       String
  from       User          @relation("FriendReqFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to         User          @relation("FriendReqTo", fields: [toId], references: [id], onDelete: Cascade)
  message    String?       // §2.3.2 optional text
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  respondedAt DateTime?

  @@unique([fromId, toId])
  @@index([toId, status])
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// §2.3.5 User-to-user ban (one-way)
model UserBlock {
  id        String   @id @default(cuid())
  byId      String   // who issued the ban
  targetId  String   // who is banned
  by        User     @relation("BlockBy", fields: [byId], references: [id], onDelete: Cascade)
  target    User     @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([byId, targetId])
  @@index([targetId])
}

// §2.4 Rooms
model Room {
  id          String      @id @default(cuid())
  name        String      @unique // §2.4.2 unique
  description String?
  visibility  Visibility  @default(PUBLIC)
  // Room kind: public/private group OR a two-person DM (§2.5.1)
  kind        RoomKind    @default(GROUP)
  ownerId     String?     // null for DM rooms
  owner       User?       @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?

  memberships Membership[]
  messages    Message[]
  bans        RoomBan[]
  invites     RoomInvite[]
  attachments Attachment[]

  @@index([visibility, deletedAt])
  @@index([kind])
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum RoomKind {
  GROUP
  DM
}

// §2.4.2 members + admins combined via role
model Membership {
  id       String   @id @default(cuid())
  userId   String
  roomId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())
  // §2.7.1 unread counter convenience — could also compute via Message timestamps
  lastReadAt DateTime @default(now())

  @@unique([userId, roomId])
  @@index([roomId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// §2.4.8 room ban list
model RoomBan {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  bannedById String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

// §2.4.9 invites to private rooms
model RoomInvite {
  id        String        @id @default(cuid())
  roomId    String
  inviteeId String
  inviterId String
  status    InviteStatus  @default(PENDING)
  createdAt DateTime      @default(now())
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, inviteeId])
  @@index([inviteeId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// §2.5 Messages
model Message {
  id              String    @id @default(cuid())
  roomId          String
  authorId        String
  body            String    @db.Text // §2.5.2 up to 3 KB, UTF-8
  replyToId       String?
  editedAt        DateTime? // §2.5.4 "edited" indicator
  deletedAt       DateTime? // §2.5.5 soft-delete
  createdAt       DateTime  @default(now())

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     Message?     @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]    @relation("ReplyTo")
  attachments Attachment[]

  @@index([roomId, createdAt])
  @@index([authorId])
}

// §2.6 Attachments — files stored on local FS, metadata in DB
model Attachment {
  id           String   @id @default(cuid())
  messageId    String?  // null during upload, set when message is sent
  roomId       String
  uploaderId   String
  originalName String   // §2.6.3 preserve original name
  storagePath  String   // relative path under UPLOAD_DIR
  mimeType     String
  sizeBytes    Int
  comment      String?  // §2.6.3 optional comment
  createdAt    DateTime @default(now())

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([roomId])
}
